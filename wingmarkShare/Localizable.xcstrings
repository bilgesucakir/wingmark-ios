            "value" : "Bu şifre bir veri sızıntısında yer almış. Lütfen başka bir şifre seç."
          }
        }
      }
    },
    "You're offline. Check your connection and try again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
